.DS_Store
node_modules/
package-lock.json
*.zip

# never commit worker source or config — that is where keys have leaked before
cloudfareworker*.js
wrangler.toml
.wrangler/
.env

# regenerated by test/extract.mjs on every run
test/.generated/
dist/

# Raw video: masters and exports stay on the machine. Only the web copy the site
# serves is tracked, and the Pages repo should never carry a 25 MB master.
*.mp4
!docs/media/*.mp4
for website-poster.jpg

# Search Console and Bing keyword exports are not public (they carry query data)
Keyword Stats*.csv
