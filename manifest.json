{
  "manifest_version": 3,
  "name": "Context Reader (Direct) \u2014 Sinhala",
  "version": "2.1.0",
  "description": "Experiment build: calls Gemini directly with your own API key. No proxy, no cache.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "Readability.min.js",
        "content.js"
      ],
      "exclude_matches": [
        "*://*/options.html",
        "*://*/welcome.html"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "welcome.html",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "Context Reader",
    "default_icon": "icon128.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
